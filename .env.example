# Postgres connection string. On Railway this comes from the Postgres plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kell_studio"

# Secret for signing Auth.js JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Canonical URL of the deployed app. MUST include the scheme (https://...) —
# a bare domain crashes every request with "TypeError: Invalid URL".
# On Railway, set it to: https://${{RAILWAY_PUBLIC_DOMAIN}}
AUTH_URL="http://localhost:3000"

# Email address of the single owner account, created by the seed.
OWNER_EMAIL="you@example.com"

# Password for the owner account. The seed stores only a bcrypt hash (cost 12).
OWNER_PASSWORD="change-me"

# Cloudflare R2 (S3-compatible) — the File Vault. Without these the app
# falls back to a dev-only in-memory store; production must set all four.
# The bucket needs a CORS rule allowing PUT/GET from the app's origin.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Resend, for the "new intake response" email. Optional — sends are skipped
# when unset. EMAIL_FROM must be a verified sender, e.g. "Studio <studio@yourdomain.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

# AssemblyAI, for voice-memo transcription (KS-05). Without it a canned
# dev fake runs — production needs the real key.
ASSEMBLYAI_API_KEY=""

# Anthropic, for fact extraction from captures (KS-05). AI_MODEL overrides
# the default model if you ever want to change it.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# Shared secret for the pipeline heartbeat: Railway cron hits
# /api/jobs/tick?key=<CRON_SECRET> every minute. When unset the route is
# open (local dev only). Generate with: openssl rand -hex 24
CRON_SECRET=""
