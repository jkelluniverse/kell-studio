generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isRoot    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  projects      Project[]
  phases        Phase[]
  milestones    Milestone[]
  captures      Capture[]
  facts         Fact[]
  factCitations FactCitation[]
  decisions     Decision[]
  ideas         Idea[]
  documents     Document[]
  reminders     Reminder[]
  aiThreads     AIThread[]
  aiMessages    AIMessage[]
  intakeForms     IntakeForm[]
  intakeItems     IntakeItem[]
  intakeResponses IntakeResponse[]
  intakeAnswers   IntakeAnswer[]
  loginTokens     LoginToken[]
  projectMessages ProjectMessage[]
}

model User {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  email    String   @unique
  // KS-06 DECISION: nullable — CLIENT users never have a password (§1), and
  // a row with no hash is the honest shape for that; a random unusable hash
  // would be a fake. authorize() treats null as "cannot sign in by password".
  passwordHash String?
  role         UserRole @default(OWNER)
  name         String?
  // Set for CLIENT users (createPortalUser enforces it); null for the owner.
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  disabledAt   DateTime? // revoked portal access; sessions die at middleware
  lastSignInAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  loginTokens LoginToken[]
  messages    ProjectMessage[]

  @@index([tenantId])
  @@index([clientId])
}

enum UserRole {
  OWNER
  CLIENT       // portal users (KS-06)
  COLLABORATOR // reserved for v0.3, unused in v0.1
}

// One-time portal sign-in token (KS-06). Only the SHA-256 of the raw token is
// stored; the raw value exists in the email link and nowhere else.
model LoginToken {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([tenantId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// KS-02 domain schema. Every model below is tenant-scoped: it carries
// tenantId (with a real FK to Tenant, matching the KS-01 User pattern) and
// is listed in TENANT_SCOPED_MODELS in src/lib/db/scoped.ts.
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  status       ClientStatus @default(PROSPECT)
  slug         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?

  projects    Project[]
  portalUsers User[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Project {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   Client        @relation(fields: [clientId], references: [id])
  name     String
  slug     String
  status   ProjectStatus @default(ACTIVE)
  summary  String?

  phases    Phase[]
  captures  Capture[]
  facts     Fact[]
  decisions Decision[]
  documents Document[]
  threads   AIThread[]
  intakeForms IntakeForm[]
  // KS-02 DECISION: the spec's Project relation list omits ideas, but
  // Idea.projectId has a relation and Prisma requires the back-relation
  // field. Schema-only; nothing reads Project.ideas yet.
  ideas     Idea[]
  messages  ProjectMessage[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAST
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

model Phase {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  name        String
  order       Int
  status          PhaseStatus @default(NOT_STARTED)
  blockedNote     String? // required by setPhaseStatus when status is BLOCKED; never leaves the internal side
  visibleToClient Boolean     @default(true) // the portal (KS-06) reads this

  milestones Milestone[]

  @@unique([projectId, order])
  @@index([tenantId])
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

model Milestone {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phaseId String
  phase   Phase          @relation(fields: [phaseId], references: [id])
  title   String
  dueOn   DateTime
  doneAt  DateTime?
  ownedBy MilestoneOwner @default(JACOB)
  note    String? // one plain-text line of context

  reminders Reminder[]

  @@index([tenantId])
  @@index([tenantId, dueOn])
}

enum MilestoneOwner {
  JACOB
  CLIENT
}

model Capture {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String? // nullable: a capture may arrive before it's assigned
  project   Project?      @relation(fields: [projectId], references: [id])
  kind      CaptureKind
  body      String
  rawRef    String? // R2 key of original audio (KS-04 presigned path)
  status    CaptureStatus @default(READY)
  // Provider job id while transcribing; plain-English note when FAILED.
  transcriptJobId String?
  failureNote     String?
  capturedAt      DateTime @default(now())

  citations FactCitation[]
  decisions Decision[]

  @@index([tenantId])
  @@index([tenantId, projectId, capturedAt])
}

enum CaptureKind {
  TEXT
  VOICE
  EMAIL
}

enum CaptureStatus {
  READY
  TRANSCRIBING
  EXTRACTING
  REVIEW
  DONE
  FAILED
}

model Fact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  kind        FactKind
  body        String
  status      FactStatus @default(PROPOSED)
  confirmedAt DateTime?

  citations FactCitation[]

  @@index([tenantId])
  @@index([tenantId, projectId, status])
}

enum FactKind {
  PREFERENCE
  CONSTRAINT
  VOCABULARY
  FEAR
  GOAL
  TOOL
  PERSON
}

enum FactStatus {
  PROPOSED
  CONFIRMED
  RETIRED
}

model FactCitation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factId    String
  fact      Fact    @relation(fields: [factId], references: [id], onDelete: Cascade)
  captureId String
  capture   Capture @relation(fields: [captureId], references: [id], onDelete: Restrict)
  excerpt   String?

  @@unique([factId, captureId])
  @@index([tenantId])
}

model Decision {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  title     String
  rationale String // required; recordDecision() enforces non-blank
  decidedOn DateTime
  captureId String?
  capture   Capture? @relation(fields: [captureId], references: [id])

  // Decisions are never edited — they're superseded. supersededById on the
  // OLD decision points at the decision that replaced it.
  supersededById String?
  supersededBy   Decision?  @relation("DecisionSupersession", fields: [supersededById], references: [id])
  supersedes     Decision[] @relation("DecisionSupersession")

  @@index([tenantId])
}

model Idea {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId   String? // null = studio-wide
  project     Project?   @relation(fields: [projectId], references: [id])
  title       String
  body        String?
  bringBackOn DateTime?
  status      IdeaStatus @default(PARKED)

  reminders Reminder[]

  @@index([tenantId])
  @@index([tenantId, bringBackOn])
}

enum IdeaStatus {
  PARKED
  REVIVED
  DROPPED
}

model Document {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  title     String
  r2Key     String? // key into the R2 storage adapter
  body      String? // inline markdown; createDocument() enforces r2Key-or-body
  mimeType  String?

  sizeBytes    Int?
  originalName String?
  source       DocumentSource @default(JACOB)
  // Portal visibility (KS-06). registerUpload defaults it from the source:
  // a client's own files (CLIENT_INTAKE / CLIENT_PORTAL) start visible,
  // JACOB / SYSTEM start hidden until toggled.
  visibleToClient Boolean @default(false)
  // Set when the file arrived via an intake submission. SetNull on response
  // deletion: the file survives in the vault; only the intake link clears.
  intakeResponseId String?
  intakeResponse   IntakeResponse? @relation(fields: [intakeResponseId], references: [id], onDelete: SetNull)
  // KS-04 DECISION: bare column (no relation) — the item link is a display
  // hint, not an integrity constraint; a deleted draft item shouldn't be
  // able to strand or block documents.
  intakeItemId String?

  @@index([tenantId])
}

enum DocumentSource {
  JACOB
  CLIENT_INTAKE
  CLIENT_PORTAL
  SYSTEM
}

// The project message thread (KS-06): one thread per project, both sides
// post, nothing is edited or deleted — it's a record.
model ProjectMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
  body      String
  readAt    DateTime? // set when the other side loads the thread
  // KS-06 DECISION: the 10-minute notice batch guard reads this column
  // instead of in-memory state, so it holds across restarts and is testable:
  // set when a notice email went out for this message.
  noticedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, projectId, createdAt])
}

model IntakeForm {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  title     String
  intro     String? // plain-words paragraph the client sees
  status    IntakeStatus @default(DRAFT)
  token     String       @unique // unguessable, nanoid >= 24 chars
  openedAt  DateTime?
  closedAt  DateTime?

  items     IntakeItem[]
  responses IntakeResponse[]

  @@index([tenantId])
}

enum IntakeStatus {
  DRAFT
  OPEN
  CLOSED
}

model IntakeItem {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formId   String
  form     IntakeForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  order    Int
  kind     IntakeItemKind
  prompt   String
  required Boolean        @default(true)
  choices  String[] // CHOICE only

  answers IntakeAnswer[]

  @@unique([formId, order])
  @@index([tenantId])
}

enum IntakeItemKind {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  CHOICE
  FILE_REQUEST
}

model IntakeResponse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formId          String
  form            IntakeForm @relation(fields: [formId], references: [id])
  submittedAt     DateTime? // null while in progress
  respondentName  String?
  respondentEmail String?

  answers   IntakeAnswer[]
  documents Document[]

  @@index([tenantId])
}

model IntakeAnswer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responseId  String
  response    IntakeResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  itemId      String
  item        IntakeItem     @relation(fields: [itemId], references: [id])
  valueText   String?
  valueBool   Boolean?
  valueChoice String?

  @@unique([responseId, itemId])
  @@index([tenantId])
}

model Reminder {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind ReminderKind
  // KS-02 DECISION: a reminder dies with its target (onDelete: Cascade on
  // both optional relations). The default SetNull would leave a kind-tagged
  // reminder with no target, which createReminder makes unrepresentable.
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  ideaId      String?
  idea        Idea?      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  remindOn    DateTime
  sentAt      DateTime?

  @@index([tenantId])
  @@index([tenantId, remindOn, sentAt])
}

enum ReminderKind {
  MILESTONE
  IDEA
}

model AIThread {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  title     String?

  messages AIMessage[]

  @@index([tenantId])
}

model AIMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threadId        String
  thread          AIThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role            AIRole
  body            String
  citedCaptureIds String[] // light by design — cites captures without join-table weight

  @@index([tenantId])
}

enum AIRole {
  USER
  ASSISTANT
}
